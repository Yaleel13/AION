# Environment variables for AION
# Copy this file to .env and fill in your API keys.
# Never commit a real .env file or real secrets.

# OpenAI (ChatGPT) API key
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# Moltbook (Phase 1: read-only)
# ---------------------------------------------------------------------------
# mode: mock (default, no network) | live (requires API key; reads only)
MOLTBOOK_MODE=mock
# Never commit a real Moltbook API key.
MOLTBOOK_API_KEY=your_moltbook_agent_api_key_here
# Must use the www host in live mode (non-www redirects strip Authorization).
MOLTBOOK_BASE_URL=https://www.moltbook.com/api/v1
MOLTBOOK_TIMEOUT_SECONDS=20
MOLTBOOK_MAX_RETRIES=3
# Client-side ceiling; Moltbook GET limit is 60/min. Stay at or below.
MOLTBOOK_RATE_LIMIT_PER_MINUTE=30
# Phase 1 hard-disables outbound. Do not set true until Phase 2 is approved.
MOLTBOOK_OUTBOUND_ENABLED=false
# Optional path for append-only JSON audit lines (credentials are redacted).
# MOLTBOOK_AUDIT_LOG_PATH=/tmp/aion-moltbook-audit.jsonl

# ---------------------------------------------------------------------------
# Phase 2 controlled growth (draft/approval/leads/paper)
# ---------------------------------------------------------------------------
# Owner dashboard / API bearer token (server-side only; never NEXT_PUBLIC_)
AION_OWNER_TOKEN=your_local_owner_dashboard_token_here
# Pepper for hashing single-use approval tokens
AION_APPROVAL_TOKEN_PEPPER=change-me-to-a-long-random-string
# Emergency stop: true forces read-only / no paper ticks via owner API
AION_KILL_SWITCH=false
# SQLite paths (local only)
AION_PHASE2_DB=/tmp/aion_phase2.db
AION_PAPER_DB=/tmp/aion_paper_trading.db
# mock | live_public (CoinGecko public prices; no trading keys)
AION_PAPER_PRICE_MODE=mock
# Must remain false unless you explicitly intend to consume approval tokens
# for a future publish path. This build still does not network-publish.
MOLTBOOK_PHASE2_EXECUTE=false
# Next.js → FastAPI base for /api/owner proxy routes
AION_API_BASE=http://127.0.0.1:8000

# Application settings
APP_HOST=0.0.0.0
APP_PORT=8000

# AION agent runtime
# AION_MODEL=gpt-5.6-terra
# AION_SESSION_DB=/tmp/aion_sessions.db
# AION_MAX_TURNS=8
