# Environment variables for AION
# Copy this file to .env and fill in your API keys.
# Never commit a real .env file or real secrets.

# OpenAI (ChatGPT) API key
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# Moltbook (Phase 1: read-only)
# ---------------------------------------------------------------------------
# mode: mock (default, no network) | live (requires API key; reads only)
MOLTBOOK_MODE=mock
# Never commit a real Moltbook API key.
MOLTBOOK_API_KEY=your_moltbook_agent_api_key_here
# Must use the www host in live mode (non-www redirects strip Authorization).
MOLTBOOK_BASE_URL=https://www.moltbook.com/api/v1
MOLTBOOK_TIMEOUT_SECONDS=20
MOLTBOOK_MAX_RETRIES=3
# Client-side ceiling; Moltbook GET limit is 60/min. Stay at or below.
MOLTBOOK_RATE_LIMIT_PER_MINUTE=30
# Phase 1 hard-disables outbound. Do not set true until Phase 2 is approved.
MOLTBOOK_OUTBOUND_ENABLED=false
# Optional path for append-only JSON audit lines (credentials are redacted).
# MOLTBOOK_AUDIT_LOG_PATH=/tmp/aion-moltbook-audit.jsonl

# ---------------------------------------------------------------------------
# Phase 2 controlled growth (draft/approval/leads/paper)
# ---------------------------------------------------------------------------
# Owner dashboard / API bearer token (server-side only; never NEXT_PUBLIC_)
# Generate with: python3 scripts/generate_owner_token.py
AION_OWNER_TOKEN=your_local_owner_dashboard_token_here
# Pepper for hashing single-use approval tokens
AION_APPROVAL_TOKEN_PEPPER=change-me-to-a-long-random-string
# Owner-only alerts via Resend (never emails prospects)
# RESEND_API_KEY=
# AION_OWNER_ALERT_EMAIL=ybenson@yalitekonline.com
# AION_ALERT_FROM_EMAIL=AION <alerts@your-verified-domain>
# AION_OWNER_ALERTS_ENABLED=true
# Emergency stop: true forces read-only / no paper ticks via owner API
AION_KILL_SWITCH=false
# Durable storage root (preferred over /tmp). Gitignored.
AION_DATA_DIR=data/aion
# Optional explicit SQLite paths (defaults under AION_DATA_DIR)
# AION_PHASE2_DB=data/aion/phase2.db
# AION_PAPER_DB=data/aion/paper_trading.db
# AION_SESSION_DB=data/aion/sessions.db
# AION_ACTIVATION_DIR=data/aion/activation
# Managed Postgres (dedicated aion schema ONLY). Requires owner cost approval (~$10/mo).
# Never point at YaliTek or Elaria production databases.
# AION_DATABASE_URL=
# mock | live_public (CoinGecko public prices; no trading keys). Prefer live_public.
AION_PAPER_PRICE_MODE=live_public
# Must remain false unless you explicitly intend to consume approval tokens
# for a future publish path. This build still does not network-publish.
MOLTBOOK_PHASE2_EXECUTE=false

# ---------------------------------------------------------------------------
# Controlled autonomy (14-day experiment) — INACTIVE by default
# ---------------------------------------------------------------------------
# Do NOT set true until final owner activation approval after the safety report.
MOLTBOOK_CONTROLLED_AUTONOMY=false
# Keep true unless final approval explicitly authorizes live network writes.
MOLTBOOK_AUTONOMY_DRY_RUN=true
# Set only at activation (ISO-8601 UTC). Example: 2026-08-27T12:00:00+00:00
# MOLTBOOK_EXPERIMENT_STARTED_AT=
# Quota profile: expanded (2/8/15) or reduced (1/3/5). Auto-reduction persists in DB.
# MOLTBOOK_QUOTA_PROFILE=expanded
# Optional ceiling overrides (still subject to pacing + platform limits):
# MOLTBOOK_MAX_POSTS_PER_24H=2
# MOLTBOOK_MAX_COMMENTS_PER_24H=8
# MOLTBOOK_MAX_FOLLOWS_PER_7D=15

# Next.js → FastAPI base for /api/owner proxy routes
AION_API_BASE=http://127.0.0.1:8000

# Application settings
APP_HOST=0.0.0.0
APP_PORT=8000

# AION agent runtime
# AION_MODEL=gpt-5.6-terra
# AION_SESSION_DB=/tmp/aion_sessions.db
# AION_MAX_TURNS=8

# ---------------------------------------------------------------------------
# Durable scheduler
# ---------------------------------------------------------------------------
# AION_SCHEDULER_INTERVAL_MINUTES=60
# AION_SCHEDULER_LOCK_TTL_SECONDS=900
# AION_SCHEDULER_MISS_AFTER_MINUTES=150
# AION_SCHEDULER_FAIL_READONLY_AFTER=3
