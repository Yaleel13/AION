# Environment variables for AION
# Copy this file to .env for local development or configure the equivalent
# server-side variables in the deployment platform. Never commit real secrets.

# ---------------------------------------------------------------------------
# Reasoning providers
# ---------------------------------------------------------------------------
# Optional direct OpenAI Responses API path. On Vercel, basic chat can fall
# back to Vercel AI Gateway/OIDC when this is unset.
OPENAI_API_KEY=your_openai_api_key_here
# Direct OpenAI model when OPENAI_API_KEY is configured.
# AION_MODEL=gpt-5.4
# Vercel AI Gateway model used by the keyless production fallback.
# AION_GATEWAY_MODEL=openai/gpt-5.4

# Optional Google Gemini provider
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# Moltbook
# ---------------------------------------------------------------------------
# mode: mock (default, no network) | live (requires API key)
MOLTBOOK_MODE=mock
MOLTBOOK_API_KEY=your_moltbook_agent_api_key_here
MOLTBOOK_BASE_URL=https://www.moltbook.com/api/v1
MOLTBOOK_TIMEOUT_SECONDS=20
MOLTBOOK_MAX_RETRIES=3
MOLTBOOK_RATE_LIMIT_PER_MINUTE=30
# Outbound remains disabled unless deliberately approved.
MOLTBOOK_OUTBOUND_ENABLED=false

# ---------------------------------------------------------------------------
# Owner operations / approvals
# ---------------------------------------------------------------------------
# Server-side only. Never prefix these with NEXT_PUBLIC_.
AION_OWNER_TOKEN=replace-with-a-long-random-owner-token
AION_APPROVAL_TOKEN_PEPPER=replace-with-a-separate-long-random-pepper
# Vercel Cron sends this value as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=replace-with-a-long-random-cron-secret
# Emergency stop: true forces read-only / blocks execution paths.
AION_KILL_SWITCH=false

# ---------------------------------------------------------------------------
# Durable AION storage
# ---------------------------------------------------------------------------
# Local/server SQLite root. On serverless Vercel, SQLite is ephemeral and the
# runtime will correctly report it as not durable.
AION_DATA_DIR=data/aion
# AION_PHASE2_DB=data/aion/phase2.db
# AION_PAPER_DB=data/aion/paper_trading.db
# AION_SESSION_DB=data/aion/sessions.db
# AION_ACTIVATION_DIR=data/aion/activation

# Production durable Postgres — dedicated AION Supabase project only.
# Project: gtviwpevltuqhygsbsou; schema: aion; least-privilege role: aion_app.
# Prefer the transaction pooler. Never use YaliTek or Elaria databases.
# AION_DATABASE_URL=postgresql://aion_app.gtviwpevltuqhygsbsou:<password>@aws-0-us-west-2.pooler.supabase.com:6543/postgres?sslmode=require

# ---------------------------------------------------------------------------
# Paper market / controlled autonomy
# ---------------------------------------------------------------------------
# mock | live_public. This is paper trading only; no live trading keys.
AION_PAPER_PRICE_MODE=live_public
MOLTBOOK_PHASE2_EXECUTE=false

# INACTIVE by default. Do not enable without explicit owner activation.
MOLTBOOK_CONTROLLED_AUTONOMY=false
MOLTBOOK_AUTONOMY_DRY_RUN=true
# MOLTBOOK_EXPERIMENT_STARTED_AT=2026-08-27T12:00:00+00:00
# MOLTBOOK_QUOTA_PROFILE=expanded
# MOLTBOOK_MAX_POSTS_PER_24H=2
# MOLTBOOK_MAX_COMMENTS_PER_24H=8
# MOLTBOOK_MAX_FOLLOWS_PER_7D=15

# ---------------------------------------------------------------------------
# FastAPI / agent runtime
# ---------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
# AION_MAX_TURNS=8

# ---------------------------------------------------------------------------
# Next.js Supabase client (browser-safe values only)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://gtviwpevltuqhygsbsou.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# NOTE: AION_API_BASE is intentionally not used in production. Owner/runtime
# routes are deployed as Vercel Python functions in the same AION project.
