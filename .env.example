# Environment variables for AION
# Copy this file to .env for local development or configure the equivalent
# server-side variables in the deployment platform. Never commit real secrets.

# ---------------------------------------------------------------------------
# Reasoning providers
# ---------------------------------------------------------------------------
# AION OS local mode is secretless by default. When AION_RUNTIME_MODE=local,
# chat prefers Ollama on loopback and the dedicated local AION model.
# AION_RUNTIME_MODE=local
# AION_OLLAMA_URL=http://127.0.0.1:11434
# AION_LOCAL_MODEL=aion:latest
# AION_LOCAL_CONTEXT=4096
# AION_OLLAMA_TIMEOUT_MS=120000
# Local mode never falls back to cloud unless this explicit owner gate is true.
# AION_ALLOW_CLOUD_FALLBACK=false

# ---------------------------------------------------------------------------
# Local voice runtime
# ---------------------------------------------------------------------------
# Capture stays fail-closed until the owner explicitly enables it in local mode.
# AION_AUDIO_CAPTURE_ENABLED=false
# Bounded one-shot capture duration in seconds.
# AION_AUDIO_CAPTURE_SECONDS=6
# AION_WHISPER_BIN=/home/<user>/.local/bin/whisper-cli
# AION_WHISPER_MODEL=/home/<user>/.local/share/aion/whisper.cpp/models/ggml-tiny.en.bin
# Optional vocabulary/context hint for local STT.
# AION_WHISPER_PROMPT=AION. Yaleel, pronounced YahLee-el. YaliTek. Elaria.
# Stable durable local conversation identity for one-shot voice turns.
# AION_VOICE_SESSION_ID=aion-local-voice-primary
# Piper voice model (.onnx); the matching .onnx.json file must sit beside it.
# AION_PIPER_VOICE=/home/<user>/.local/share/aion/piper/en_US-ryan-medium.onnx
# Piper phoneme duration. 1.0 is the voice default; values above 1.0 speak slower.
# AION_PIPER_LENGTH_SCALE=1.12
# Seconds of pause added between sentences for clearer spoken cadence.
# AION_PIPER_SENTENCE_SILENCE=0.20
# Set false to synthesize the reply WAV without automatically playing it.
# AION_VOICE_PLAYBACK_ENABLED=true

# Optional direct OpenAI Responses API path. On Vercel, basic chat can fall
# back to Vercel AI Gateway/OIDC when this is unset.
OPENAI_API_KEY=your_openai_api_key_here
# Direct OpenAI model when OPENAI_API_KEY is configured.
# AION_MODEL=gpt-5.4
# Vercel AI Gateway model used by the keyless production fallback.
# AION_GATEWAY_MODEL=openai/gpt-5.4

# Optional Google Gemini provider
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# Moltbook
# ---------------------------------------------------------------------------
# mode: mock (default, no network) | live (requires API key)
MOLTBOOK_MODE=mock
MOLTBOOK_API_KEY=your_moltbook_agent_api_key_here
MOLTBOOK_BASE_URL=https://www.moltbook.com/api/v1
MOLTBOOK_TIMEOUT_SECONDS=20
MOLTBOOK_MAX_RETRIES=3
MOLTBOOK_RATE_LIMIT_PER_MINUTE=30
# Separate fail-closed gates. Keep both false unless the owner explicitly
# activates controlled outbound after quality and endpoint acceptance checks.
MOLTBOOK_OUTBOUND_ENABLED=false
MOLTBOOK_EXECUTE_ENABLED=false

# ---------------------------------------------------------------------------
# Owner operations / approvals
# ---------------------------------------------------------------------------
# Server-side only. Never prefix these with NEXT_PUBLIC_.
AION_OWNER_TOKEN=replace-with-a-long-random-owner-token
AION_APPROVAL_TOKEN_PEPPER=replace-with-a-separate-long-random-pepper
# Vercel Cron sends this value as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=replace-with-a-long-random-cron-secret
# Payment fulfillment cron remains inert unless explicitly enabled.
FULFILLMENT_CRON_ENABLED=false
# Emergency stop: true forces read-only / blocks execution paths.
AION_KILL_SWITCH=false

# ---------------------------------------------------------------------------
# Durable AION storage
# ---------------------------------------------------------------------------
# Local/server SQLite root. On serverless Vercel, SQLite is ephemeral and the
# runtime will correctly report it as not durable.
AION_DATA_DIR=data/aion
# AION_PHASE2_DB=data/aion/phase2.db
# AION_PAPER_DB=data/aion/paper_trading.db
# AION_SESSION_DB=data/aion/sessions.db
# AION_ACTIVATION_DIR=data/aion/activation

# Production durable Postgres — dedicated AION Supabase project only.
# Project: gtviwpevltuqhygsbsou; schema: aion; least-privilege role: aion_app.
# Prefer the transaction pooler. Never use YaliTek or Elaria databases.
# AION_DATABASE_URL=postgresql://aion_app.gtviwpevltuqhygsbsou:<password>@aws-0-us-west-2.pooler.supabase.com:6543/postgres?sslmode=require

# ---------------------------------------------------------------------------
# Paper market / controlled autonomy
# ---------------------------------------------------------------------------
# mock | live_public. This is paper trading only; no live trading keys.
AION_PAPER_PRICE_MODE=live_public

# INACTIVE by default. This is separate from owner-controlled comment execution.
# Do not enable without an additional explicit owner activation.
MOLTBOOK_CONTROLLED_AUTONOMY=false
MOLTBOOK_AUTONOMY_DRY_RUN=true
# MOLTBOOK_EXPERIMENT_STARTED_AT=2026-08-27T12:00:00+00:00
# MOLTBOOK_QUOTA_PROFILE=expanded
# MOLTBOOK_MAX_POSTS_PER_24H=2
# MOLTBOOK_MAX_COMMENTS_PER_24H=8
# MOLTBOOK_MAX_FOLLOWS_PER_7D=15

# ---------------------------------------------------------------------------
# FastAPI / agent runtime
# ---------------------------------------------------------------------------
# Loopback is the safe local default. Set APP_HOST=0.0.0.0 only when you
# intentionally want to expose FastAPI to other machines on the network.
APP_HOST=127.0.0.1
APP_PORT=8000
# AION_MAX_TURNS=8
# Per-client sliding-window limit for the public FastAPI /agent endpoint.
# NOTE: in-process only — not fleet-wide across Vercel isolates.
AGENT_RATE_LIMIT_PER_MINUTE=30
# Per-client sliding-window limit for POST /api/aion/chat (Next.js).
# Same caveat: in-process per Vercel isolate. Migrate to KV for fleet-wide limits.
CHAT_RATE_LIMIT_PER_MINUTE=20

# ---------------------------------------------------------------------------
# Revenue scouts — distribution expansion
# ---------------------------------------------------------------------------
# Comma-separated additional HTTPS URLs for the commercial scout (JSON endpoints).
# Built-in sources: HN Algolia, Reddit r/forhire + r/freelance, GitHub issues.
# Add more here if you want to monitor additional public buyer-intent feeds.
# AION_COMMERCIAL_SCOUT_URLS=
# AION_WEB_SCOUT_URLS=

# ---------------------------------------------------------------------------
# Stripe (fail-closed until the owner enables checkout in Vercel)
# ---------------------------------------------------------------------------
# Production secrets live in Vercel project env, not in this file.
# See docs/AION_GO_LIVE_REVENUE.md for production activation.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_ENABLED=false

# ---------------------------------------------------------------------------
# Next.js Supabase client (browser-safe values only)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://gtviwpevltuqhygsbsou.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# NOTE: AION_API_BASE is intentionally not used in production. Owner/runtime
# routes are deployed as Vercel Python functions in the same AION project.
