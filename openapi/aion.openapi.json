{
  "components": {
    "schemas": {
      "AIResponse": {
        "description": "Unified response returned by legacy provider endpoints.",
        "properties": {
          "message": {
            "description": "Original user message",
            "title": "Message",
            "type": "string"
          },
          "model": {
            "description": "Model used",
            "title": "Model",
            "type": "string"
          },
          "provider": {
            "description": "AI provider name",
            "title": "Provider",
            "type": "string"
          },
          "response": {
            "description": "AI-generated response text",
            "title": "Response",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "model",
          "message",
          "response"
        ],
        "title": "AIResponse",
        "type": "object"
      },
      "AgentRequest": {
        "description": "Payload sent to the primary AION agent runtime.",
        "properties": {
          "message": {
            "description": "User request for AION",
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "session_id": {
            "description": "Conversation/session identifier used for continuity",
            "minLength": 1,
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "AgentRequest",
        "type": "object"
      },
      "AgentResponse": {
        "properties": {
          "agent": {
            "title": "Agent",
            "type": "string"
          },
          "requires_approval": {
            "default": false,
            "title": "Requires Approval",
            "type": "boolean"
          },
          "response": {
            "title": "Response",
            "type": "string"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/AgentUsage"
          }
        },
        "required": [
          "agent",
          "session_id",
          "response",
          "usage"
        ],
        "title": "AgentResponse",
        "type": "object"
      },
      "AgentUsage": {
        "properties": {
          "input_tokens": {
            "title": "Input Tokens",
            "type": "integer"
          },
          "output_tokens": {
            "title": "Output Tokens",
            "type": "integer"
          },
          "requests": {
            "title": "Requests",
            "type": "integer"
          },
          "total_tokens": {
            "title": "Total Tokens",
            "type": "integer"
          }
        },
        "required": [
          "requests",
          "input_tokens",
          "output_tokens",
          "total_tokens"
        ],
        "title": "AgentUsage",
        "type": "object"
      },
      "ChatGPTRequest": {
        "description": "Legacy payload sent to the ChatGPT endpoint.",
        "properties": {
          "message": {
            "description": "User message to send to ChatGPT",
            "title": "Message",
            "type": "string"
          },
          "model": {
            "default": "gpt-4o-mini",
            "description": "OpenAI model to use",
            "title": "Model",
            "type": "string"
          },
          "system_prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional system prompt",
            "title": "System Prompt"
          }
        },
        "required": [
          "message"
        ],
        "title": "ChatGPTRequest",
        "type": "object"
      },
      "GeminiRequest": {
        "description": "Legacy payload sent to the Gemini endpoint.",
        "properties": {
          "message": {
            "description": "User message to send to Gemini",
            "title": "Message",
            "type": "string"
          },
          "model": {
            "default": "gemini-1.5-flash",
            "description": "Gemini model to use",
            "title": "Model",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "GeminiRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The Alchemical Intelligence for Ontological Navigation.",
    "title": "AION",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/agent": {
      "post": {
        "description": "Run one turn through the primary AION agent orchestrator.",
        "operationId": "agent_endpoint_agent_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run AION"
      }
    },
